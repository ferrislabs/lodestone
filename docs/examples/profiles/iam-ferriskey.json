{
  "schema_version": 5,
  "identity": {
    "offer": "FerrisKey (open source IAM/CIAM in Rust) and Autharie (managed IAM), both by Ferrislabs",
    "target_customer": "Organizations running self-hosted Keycloak or a similar IAM, or paying for a SaaS IAM"
  },
  "agents": [
    {
      "id": "certificate-transparency",
      "name": "Certificate transparency",
      "enabled": true,
      "source": {
        "kind": "certificate_transparency",
        "labels": ["auth", "sso", "login", "iam", "keycloak", "id", "accounts", "identity", "idp"]
      }
    },
    {
      "id": "http-probe",
      "name": "HTTP probe",
      "enabled": true,
      "source": {
        "kind": "http_probe",
        "fingerprints": [
          {
            "id": "keycloak-realm",
            "path": "/realms/master",
            "product": "keycloak",
            "matchers": [
              { "kind": "status", "equals": 200 },
              { "kind": "body", "pattern": "\"realm\"\\s*:\\s*\"master\"" }
            ]
          },
          {
            "id": "keycloak-legacy-realm",
            "path": "/auth/realms/master",
            "product": "keycloak",
            "matchers": [
              { "kind": "status", "equals": 200 },
              { "kind": "body", "pattern": "\"realm\"\\s*:\\s*\"master\"" }
            ],
            "debt_markers": [
              {
                "id": "legacy_auth_path",
                "rule": {
                  "kind": "matches",
                  "matcher": { "kind": "body", "pattern": "/auth/realms/master" }
                }
              }
            ]
          },
          {
            "id": "authentik",
            "path": "/-/health/live/",
            "product": "authentik",
            "matchers": [
              { "kind": "status", "equals": 200 },
              { "kind": "header", "name": "x-powered-by", "pattern": "^authentik$" }
            ]
          },
          {
            "id": "zitadel",
            "path": "/ui/console",
            "product": "zitadel",
            "matchers": [
              { "kind": "status", "equals": 200 },
              { "kind": "body", "pattern": "<title>ZITADEL" }
            ]
          },
          {
            "id": "ferriskey",
            "path": "/realms/master",
            "product": "ferriskey",
            "matchers": [
              { "kind": "status", "equals": 401 },
              { "kind": "body", "pattern": "\"code\"\\s*:\\s*\"E_UNAUTHORIZED\"" }
            ]
          }
        ],
        "excluded_products": ["ferriskey"]
      }
    },
    {
      "id": "dns-cname",
      "name": "DNS CNAME",
      "enabled": true,
      "source": {
        "kind": "dns_cname",
        "patterns": [
          { "provider": "auth0", "target_suffix": "auth0.com" },
          { "provider": "okta", "target_suffix": "okta.com" },
          { "provider": "okta", "target_suffix": "oktapreview.com" },
          { "provider": "azure_ad_b2c", "target_suffix": "b2clogin.com" },
          { "provider": "entra_external_id", "target_suffix": "ciamlogin.com" }
        ]
      }
    },
    {
      "id": "boamp",
      "name": "BOAMP",
      "enabled": true,
      "source": {
        "kind": "boamp",
        "keywords": ["SSO", "IAM", "gestion des identités et des accès", "fédération d'identité", "annuaire", "MFA", "Keycloak", "authentification"],
        "exclusions": ["badge", "contrôle d'accès physique", "annuaire téléphonique"]
      }
    },
    {
      "id": "decp",
      "name": "DECP",
      "enabled": true,
      "source": {
        "kind": "decp",
        "keywords": ["SSO", "IAM", "gestion des identités et des accès", "fédération d'identité", "annuaire", "MFA", "Keycloak", "authentification"],
        "exclusions": ["badge", "contrôle d'accès physique", "annuaire téléphonique"]
      }
    },
    {
      "id": "ted",
      "name": "TED",
      "enabled": true,
      "source": {
        "kind": "ted",
        "keywords": ["SSO", "IAM", "gestion des identités et des accès", "fédération d'identité", "annuaire", "MFA", "Keycloak", "authentification"],
        "exclusions": ["badge", "contrôle d'accès physique", "annuaire téléphonique"]
      }
    },
    {
      "id": "france-travail",
      "name": "France Travail",
      "enabled": true,
      "source": {
        "kind": "france_travail",
        "keywords": ["Keycloak", "IAM", "ingénieur IAM", "migration Okta", "migration Auth0", "gestion des identités"]
      }
    },
    {
      "id": "ats-fr",
      "name": "Job offers (French)",
      "enabled": true,
      "source": {
        "kind": "ats",
        "keywords": ["Keycloak", "IAM", "ingénieur IAM", "migration Okta", "migration Auth0", "gestion des identités"]
      }
    },
    {
      "id": "ats-en",
      "name": "Job offers (English)",
      "enabled": true,
      "source": {
        "kind": "ats",
        "keywords": ["identity and access management", "IAM", "SSO", "single sign-on", "Keycloak", "Okta migration"]
      },
      "llm": {
        "relevance_criteria": "The job offer is for an engineer, architect or administrator who builds or runs the organization's own identity infrastructure, for example Keycloak, or who migrates it from a SaaS IAM. Offers that only require using SSO as an end user, or roles in physical access control, are not relevant."
      }
    }
  ],
  "qualification_agents": [
    {
      "id": "pertinence",
      "name": "Pertinence",
      "description": "La pertinence du lead pour l'offre : le prospect exploite-t-il ou prépare-t-il ce que le profil cible ?",
      "enabled": true,
      "provider_id": null,
      "system_prompt": "You judge whether a company is a relevant prospect for the offer, using the relevance criteria. Base your answers only on what the documents state.\n\nRelevance criteria: The organization operates its own identity infrastructure, such as a self-hosted Keycloak, or pays for a SaaS IAM, and shows signs of migration, staffing or procurement around it. Physical access control and unrelated directories are not relevant.",
      "weight": 5,
      "questions": [
        {
          "id": "pertinence",
          "wording": "Ce lead est-il pertinent pour l'offre ?",
          "weight": 5,
          "options": [
            {
              "value": "forte",
              "label": "Forte",
              "score": 1.0
            },
            {
              "value": "moyenne",
              "label": "Moyenne",
              "score": 0.5
            },
            {
              "value": "faible",
              "label": "Faible",
              "score": 0.0
            }
          ]
        }
      ]
    },
    {
      "id": "maturite-technique",
      "name": "Maturité technique",
      "description": "La maturité technique du lead : versions utilisées, dette visible et signes de modernisation ou de migration.",
      "enabled": true,
      "provider_id": null,
      "system_prompt": "You assess how the company runs its identity infrastructure from the signals and documents. Self-hosted and ageing Keycloak, or custom authentication code, means high debt and a strong opportunity. A recent SaaS IAM means a weaker one. Answer unknown when nothing shows it.",
      "weight": 5,
      "questions": [
        {
          "id": "maturite",
          "wording": "Quelle est la maturité de l'infrastructure d'identité de l'organisation ?",
          "weight": 5,
          "options": [
            {
              "value": "legacy_auto_heberge",
              "label": "IAM auto-hébergé ancien",
              "score": 1.0
            },
            {
              "value": "saas",
              "label": "IAM SaaS",
              "score": 0.7
            },
            {
              "value": "inconnu",
              "label": "Inconnue",
              "score": 0.3
            }
          ]
        }
      ]
    },
    {
      "id": "type-organisation",
      "name": "Type d'organisation",
      "description": "Le type d'organisation du lead : administration, grande entreprise, PME ou autre structure.",
      "enabled": true,
      "provider_id": null,
      "system_prompt": "You classify the organization by type from the documents. Public bodies buy through tenders, large companies run their own IT teams, small and medium businesses rarely do. Answer unknown when nothing shows it.",
      "weight": 5,
      "questions": [
        {
          "id": "type",
          "wording": "De quel type d'organisation s'agit-il ?",
          "weight": 5,
          "options": [
            {
              "value": "public",
              "label": "Organisation publique",
              "score": 0.8
            },
            {
              "value": "grande_entreprise",
              "label": "Grande entreprise",
              "score": 1.0
            },
            {
              "value": "pme",
              "label": "PME",
              "score": 0.5
            },
            {
              "value": "inconnu",
              "label": "Inconnu",
              "score": 0.3
            }
          ]
        }
      ]
    }
  ],
  "aggregator": {
    "provider_id": null,
    "system_prompt": "You write the summary of a lead for a B2B lead detection tool. You receive the lead, its signals, and the answers and scores of every qualification agent. Write a short synthesis, the verdict narrative, an approach angle and a message draft for the operator to review. Quote evidence verbatim from the documents. Never change the computed confidence or the verdict. Base your text only on what is provided and do not invent facts."
  },
  "verdict": {
    "reliable_from": 70,
    "discard_below": 30
  },
  "scoring": {
    "factors": [
      { "signal": "product_detected", "value": "keycloak", "weight": 10 },
      { "signal": "debt_marker", "value": "legacy_auth_path", "weight": 5 },
      { "signal": "saas_provider", "weight": 3 },
      { "signal": "job_offer", "weight": 8 },
      { "signal": "public_tender", "weight": 7 },
      { "signal": "role_contact_found", "weight": 2 },
      { "signal": "distinct_signals", "weight": 2 }
    ]
  },
  "contact_ranking": {
    "preferred_local_parts": ["security", "it", "dsi", "tech", "contact", "info"],
    "guess_local_parts": ["contact", "info"]
  },
  "llm": {
    "qualification_threshold": 40,
    "relevance_criteria": "The organization operates its own identity infrastructure, such as a self-hosted Keycloak, or pays for a SaaS IAM, and shows signs of migration, staffing or procurement around it. Physical access control and unrelated directories are not relevant.",
    "language": "fr"
  }
}
