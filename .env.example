# Copy to .env and fill in. `.env` is gitignored.
#
# Values with no default are required: the process or the compose stack fails to
# start without them, rather than falling back to something published here.

# --- API ---------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=lodestone
DATABASE_USER=ferriskey
DATABASE_PASSWORD=                 # required
AUTH_ISSUER=http://localhost:3333/realms/lodestone
AUTH_CLIENT_ID=lodestone
AUTH_AUDIENCE=                     # optional, rejects tokens issued for another audience
AUTH_CLIENT_SECRET=                # required

# Serve the Scalar and Swagger interfaces. They sit outside authentication, so
# enabling them publishes the full API surface to anonymous callers.
SERVER_ENABLE_API_DOCS=false

# Trust X-Forwarded-For to identify a client for rate limiting. Only safe behind
# a reverse proxy that overwrites it; otherwise a caller picks its own bucket.
SERVER_TRUST_FORWARDED_HEADERS=false
ALLOWED_ORIGINS=http://localhost:3000  # browser origins allowed to call the API (web UI)

# --- Jobs --------------------------------------------------------------------
JOBS_WORKERS=4
JOBS_LEASE_SECONDS=300             # must exceed JOBS_POLL_INTERVAL_MS
JOBS_POLL_INTERVAL_MS=1000
JOBS_MAX_ATTEMPTS=5
JOBS_RETRY_BASE_SECONDS=10
JOBS_SHUTDOWN_GRACE_SECONDS=20
JOBS_SOURCE_INTERVAL_MINUTES=60

# --- Outbound requests -------------------------------------------------------
OUTBOUND_CONTACT=                  # required: email or https URL, sent in the User-Agent
OUTBOUND_REQUESTS_PER_HOST_PER_MINUTE=6
OUTBOUND_REVISIT_INTERVAL_HOURS=720
OUTBOUND_REQUEST_TIMEOUT_SECONDS=15

# --- Certificate Transparency ----------------------------------------------
CT_LOG_LIST_URL=https://www.gstatic.com/ct/log_list/v3/log_list.json
CT_MAX_LOGS=4
CT_TILES_PER_RUN=16
CT_MAX_LAG_TILES=256
CT_INTERVAL_SECONDS=60

# --- BOAMP -------------------------------------------------------------------
# Open public tenders from the documented OpenDataSoft API (ADR 0004: no robots.txt check, rate limit kept).
BOAMP_BASE_URL=https://boamp-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/boamp/records
BOAMP_LOOKBACK_DAYS=7
BOAMP_MAX_PAGES=20

# --- TED ---------------------------------------------------------------------
# Open EU contract notices from the documented TED Search API (POST, no key; ADR 0004: no robots.txt check, rate limit kept).
# TED_BUYER_COUNTRIES is a comma list of ISO alpha-3 codes, empty for every country.
TED_BASE_URL=https://api.ted.europa.eu/v3/notices/search
TED_LOOKBACK_DAYS=7
TED_MAX_PAGES=10
TED_BUYER_COUNTRIES=FRA

# --- France Travail ----------------------------------------------------------
# Job offers from the documented Offres d'emploi v2 API (OAuth2 client credentials, ADR 0004: no robots.txt check, rate limit kept).
# The source is disabled, and its job not scheduled, unless both credentials are set. Never commit them.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
FRANCE_TRAVAIL_PUBLISHED_SINCE_DAYS=7
FRANCE_TRAVAIL_MAX_PAGES=20

# --- ATS job boards ----------------------------------------------------------
# Open jobs of leads already detected passively (CT, HTTP probe, DNS): the ATS board is found from the lead's own careers page,
# never guessed, then read from the public Greenhouse, Lever and Ashby job board APIs (ADR 0004). Runs every JOBS_SOURCE_INTERVAL_MINUTES.
ATS_BATCH_SIZE=20
ATS_REVISIT_DAYS=7
ATS_MAX_CAREER_PATHS=6

# --- DECP --------------------------------------------------------------------
# Awarded public contracts (one JSON file per month, about 140 MB, downloaded each run) on data.gouv.fr.
# Buyer SIRET -> website goes through the Annuaire de l'administration, SIRET -> name through
# Recherche d'entreprises. All three are documented public APIs (ADR 0004).
DECP_DATASET_API_URL=https://www.data.gouv.fr/api/1/datasets/donnees-essentielles-de-la-commande-publique-fichiers-consolides/
DECP_ANNUAIRE_URL=https://api-lannuaire.service-public.fr/api/explore/v2.1/catalog/datasets/api-lannuaire-administration/records
DECP_ENTREPRISES_URL=https://recherche-entreprises.api.gouv.fr/search
DECP_LOOKBACK_DAYS=31
DECP_NOTIFIED_WITHIN_DAYS=180
DECP_INTERVAL_HOURS=24
DECP_MAX_BODY_MB=256

# --- Contact extraction ----------------------------------------------------
CONTACT_PAGE_PATHS=/,/contact,/mentions-legales,/legal,/about
CONTACT_BATCH_SIZE=10
CONTACT_MAX_RATE_LIMIT_WAIT_SECONDS=75

# --- LLM ---------------------------------------------------------------------
LLM_SECRETS_ENCRYPTION_KEY=        # required: `openssl rand -base64 32`
LLM_RUN_BUDGET_CENTS=500

# --- Webhooks ----------------------------------------------------------------
# A signed POST per validated lead, delivered through the job queue (docs/webhooks.md). Disabled unless WEBHOOK_URL is set.
# The target is operator-configured: internal hosts are allowed, redirects are not followed.
# In Kubernetes, mount WEBHOOK_URL and WEBHOOK_SECRET from a Secret. Never commit them.
WEBHOOK_URL=
WEBHOOK_SECRET=                    # required with WEBHOOK_URL, at least 32 bytes: `openssl rand -hex 32`
WEBHOOK_PROFILE_IDS=               # comma list of profile UUIDs, empty for every profile
WEBHOOK_TIMEOUT_SECONDS=10

# --- Observability -----------------------------------------------------------
ACTIVE_OBSERVABILITY=false
OTLP_ENDPOINT=http://localhost:4317
METRICS_ENDPOINT=http://localhost:4317
LOG_FILTER=info

# --- Local stack (docker compose) --------------------------------------------
POSTGRES_PASSWORD=ferriskey
SIGNOZ_JWT_SECRET=                 # required: signs the observability UI's tokens
