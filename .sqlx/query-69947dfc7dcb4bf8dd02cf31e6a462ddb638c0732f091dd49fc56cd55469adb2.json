  "query": "\n            SELECT m.id, m.organization_id, m.user_id, m.joined_at\n            FROM organization_members m\n            INNER JOIN organizations o ON o.id = m.organization_id\n            WHERE m.organization_id = $1 AND m.user_id = $2 AND o.deleted_at IS NULL\n            ",
