{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT dedup_key AS \"dedup_key!\", kind, status, run_at, attempts,\n                lease_until, last_error, updated_at\n            FROM jobs\n            WHERE dedup_key = $1 AND kind IN ('source.run', 'llm.qualify')\n            ORDER BY (status IN ('pending', 'running')) DESC, updated_at DESC\n            LIMIT 1\n            ",
