{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT lead_id,\n                bool_or(kind = $2) AS \"certificate!\",\n                bool_or(kind <> $2 AND NOT (source = ANY($3))) AS \"evidence!\"\n            FROM signals\n            WHERE lead_id = ANY($1)\n            GROUP BY lead_id\n            ",
